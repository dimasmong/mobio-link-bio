{
  "name": "mobio-link-bio",
  "private": true,
  "description": "Build a full-stack web application with React Router 7.",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:instance": "node scripts/build-instance.mjs",
    "build:prod": "node scripts/build-prod.mjs",
    "typegen": "wrangler types && react-router typegen",
    "cf-typegen": "wrangler types && react-router typegen",
    "check": "tsc && react-router build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "deploy:instance": "node scripts/deploy-instance.mjs",
    "dev": "react-router dev",
    "migrate:instance": "node scripts/migrate-instance.mjs --remote",
    "migrate:instance:local": "node scripts/migrate-instance.mjs --local",
    "preflight:instance": "node scripts/preflight-instance.mjs",
    "preview": "npm run build && vite preview",
    "typecheck": "npm run typegen && tsc -b"
  },
  "dependencies": {
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@react-router/dev": "7.9.6",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "playwright": "^1.64.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.136.1"
  },
  "cloudflare": {
